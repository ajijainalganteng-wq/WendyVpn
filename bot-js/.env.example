# ============================================================
# Konfigurasi Bot Telegram Aji / RIPZZ STORE (@Notif2Ajibot)
# Copy file ini menjadi .env lalu isi nilainya
# ============================================================

# Token bot dari @BotFather (WAJIB)
BOT_TOKEN=

# Telegram user ID admin (Aji)
ADMIN_ID=6577966386

# --- VPN Server API ---
# Bot memanggil API di server VPN untuk create/renew/delete akun
# (sesuaikan dengan API yang ada di server, misal port 5888)
VPN_API_BASE=http://127.0.0.1:5888
VPN_API_AUTH=

# Domain utama server VPN
VPN_DOMAIN=sgdo.satsetvpn.web.id

# --- CloudFront ---
# Domain CloudFront untuk mode CF (VMess/VLess/Trojan/SSH via CF)
CF_DOMAIN=
CF_VMESS_UUID=
CF_VLESS_UUID=
CF_TROJAN_PASSWORD=

# --- PPOB / Digiflazz ---
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Harga jual = harga modal + margin (default 0)
PPOB_MARGIN=0

# --- QRIS P2P Gateway (deposit saldo) ---
P2P_GATEWAY_URL=https://p2p.shifastore.my.id
P2P_API_KEY=

# --- Sidompul (cek kuota) ---
SIDOMPUL_API_KEY=

# --- Registrasi IP Lisensi Script (GitHub) ---
# Setelah pembayaran sewa lunas, bot menulis lisensi IP ke file
# "ip" di repo GitHub pemilik lewat API. Token diisi PEMILIK di
# server bot (JANGAN commit token asli ke repo).
# Buat token: GitHub > Settings > Developer settings >
# Personal access tokens (classic), scope: repo
GH_IP_TOKEN=
GH_IP_OWNER=ajijainalganteng-wq
GH_IP_REPO=WendyVpn
GH_IP_FILE=ip
GH_IP_BRANCH=main
